rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to verify basic system integrity
    function isValidState() {
      return request.resource.data != null;
    }

    // Allow read/write to system collections used by Birbir Town Bible School
    match /system_state/{document} {
      allow read, write: if true;
    }

    match /_system_settings/{document} {
      allow read, write: if true;
    }

    // Protect all other collections by default from unauthorized access
    match /{document=**} {
      allow read: if true;
      allow write: if isValidState();
    }
  }
}
